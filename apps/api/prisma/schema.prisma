// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PermissionType {
  SYSTEM
  RESOURCE
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
}

model User {
  id          String  @id @default(uuid()) @db.Uuid
  email       String  @unique @db.VarChar(255)
  username    String  @unique @db.VarChar(50)
  displayName String? @map("display_name") @db.VarChar(100)

  role            UserRole         @default(USER)
  oauthAccounts   OAuthAccount[]
  userPermissions UserPermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  credentials   UserCredential?
  profile       Profile?
  sessions      Session[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  links         Link[]
  subscription  Subscription?
  paymentOrders PaymentOrder[]

  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  plan                   Plan               @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  razorpaySubscriptionId String?            @map("razorpay_subscription_id") @db.VarChar(255)
  razorpayCustomerId     String?            @map("razorpay_customer_id") @db.VarChar(255)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  cancelledAt            DateTime?          @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model PaymentOrder {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  razorpayOrderId   String      @unique @map("razorpay_order_id") @db.VarChar(255)
  razorpayPaymentId String?     @map("razorpay_payment_id") @db.VarChar(255)
  razorpaySignature String?     @map("razorpay_signature") @db.VarChar(255)
  amount            Int         @map("amount")
  currency          String      @default("INR") @db.VarChar(10)
  status            OrderStatus @default(CREATED)
  notes             String?     @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_orders")
}

model Link {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(255)
  originalUrl String    @map("original_url") @db.Text
  shortCode   String    @unique @map("short_code") @db.VarChar(100)
  description String?   @db.Text
  icon        String?   @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  clicksCount Int       @default(0) @map("clicks_count")
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks LinkClick[]

  @@index([userId])
  @@index([shortCode])
  @@index([expiresAt])
  @@map("links")
}

model LinkClick {
  id         String   @id @default(uuid()) @db.Uuid
  linkId     String   @map("link_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(100)
  userAgent  String?  @map("user_agent") @db.VarChar(1000)
  referrer   String?  @db.VarChar(1000)
  deviceType String?  @map("device_type") @db.VarChar(50)
  browser    String?  @db.VarChar(50)
  os         String?  @db.VarChar(50)
  clickedAt  DateTime @default(now()) @map("clicked_at")

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([clickedAt])
  @@map("link_clicks")
}

enum AvatarStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Profile {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  themeId        String?      @map("theme_id") @db.Uuid
  bio            String?      @db.Text
  website        String?      @db.VarChar(255)
  location       String?      @db.VarChar(100)
  avatarKey      String?      @map("avatar_key") @db.VarChar(255)
  avatarMimeType String?      @map("avatar_mime_type") @db.VarChar(100)
  avatarStatus   AvatarStatus @default(COMPLETED) @map("avatar_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme Theme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@map("profiles")
}

model Theme {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  background  String   @db.VarChar(255)
  buttonStyle String   @map("button_style") @db.VarChar(50)
  buttonColor String   @map("button_color") @db.VarChar(50)
  textColor   String   @map("text_color") @db.VarChar(50)
  fontFamily  String   @map("font_family") @db.VarChar(50)
  isPro       Boolean  @default(false) @map("is_pro")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profiles Profile[]

  @@map("themes")
}

model UserCredential {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @unique @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(1000)
  ipAddress        String?   @map("ip_address") @db.VarChar(100)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model OAuthAccount {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  email          String?       @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_accounts")
}

model Permission {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(100)
  name        String         @db.VarChar(100)
  description String?        @db.Text
  module      String?        @db.VarChar(100)
  type        PermissionType @default(SYSTEM)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  userPermissions UserPermission[]

  @@map("permissions")
}

model UserPermission {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  role         UserRole
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("role_permissions")
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actorId      String?   @map("actor_id") @db.Uuid
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  targetUserId String?   @map("target_user_id") @db.Uuid
  action       String    @db.VarChar(100)
  entity       String    @default("SYSTEM") @db.VarChar(100)
  entityId     String?   @map("entity_id") @db.VarChar(255)
  oldRole      UserRole? @map("old_role")
  newRole      UserRole? @map("new_role")
  details      Json?
  ipAddress    String?   @map("ip_address") @db.VarChar(100)
  userAgent    String?   @map("user_agent") @db.VarChar(1000)
  createdAt    DateTime  @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
